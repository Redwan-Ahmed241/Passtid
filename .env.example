# Canonical site origin (sitemap, robots.txt, canonical links, share images).
# Leave unset on Vercel to use the project's production URL; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Secret used to sign the demo session cookie of the bundled mock API.
# Set a long random value in production. Not used once a real backend handles auth.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional search engine ownership meta tags (the Google HTML file in /public already verifies Google).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Show the booking rules page (/rules), its links and its sitemap entry. Off unless "true".
# NEXT_PUBLIC_SHOW_RULES=true

# Point the UI at the real booking backend instead of the bundled mock API.
# The backend must set the session cookie and allow credentialed CORS for this site.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

# Payments (Stripe Checkout). Without STRIPE_SECRET_KEY checkout runs in demo mode and nobody is charged.
# STRIPE_SECRET_KEY=sk_live_...
# Prices in pence (GBP). Alerts are billed every month, automatic booking is paid once.
# PLAN_NOTIFY_CENTS=400
# PLAN_AUTOBOOK_CENTS=3000
# Telegram bot username (without @) used for the alerts deep link after the notification plan is paid.
# TELEGRAM_BOT_USERNAME=
