# Canonical site origin (sitemap, robots.txt, canonical links, share images, Stripe return URLs).
# Leave unset on Vercel to use the project's production URL; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Postgres connection string. Required. The tables are created on first use.
DATABASE_URL=postgres://user:password@localhost:5432/passtid

# Secret used to sign session cookies. Required in production (the app refuses to start without it).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string

# Optional search engine ownership meta tags (the Google HTML file in /public already verifies Google).
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Show the booking rules page (/rules), its links and its sitemap entry. Off unless "true".
# NEXT_PUBLIC_SHOW_RULES=true

# Payments (Stripe Checkout). In production the key is required; outside production, without it,
# checkout runs in demo mode and nobody is charged.
# STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the webhook endpoint https://<site>/api/v1/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Prices in cents. The client has not confirmed a price list yet; these are the defaults.
# PLAN_NOTIFY_CENTS=500
# PLAN_AUTOBOOK_CENTS=2500

# Telegram bot username (without @) used for the alerts deep link after the notification plan is paid.
# TELEGRAM_BOT_USERNAME=

# Bearer token the booking bot uses to call /api/v1/bot/*. Without it those endpoints are disabled.
# BOT_API_KEY=
